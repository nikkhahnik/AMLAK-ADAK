# generated by scripts/build_seo.py - do not edit by hand
# Apache / LiteSpeed equivalent of _headers + _redirects + netlify.toml

DirectoryIndex index.html
Options -Indexes -MultiViews
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# let the admin API receive the Authorization header on FastCGI hosts
<IfModule mod_cgi.c>
  CGIPassAuth On
</IfModule>
<IfModule mod_proxy_fcgi.c>
  CGIPassAuth On
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType text/javascript .js .mjs
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  SetEnvIf Request_URI "^/darkhast-melk/" ADAK_DARKHAST_MELK=1
  Header always set X-Content-Type-Options "nosniff" env=ADAK_DARKHAST_MELK
  Header always set Referrer-Policy "strict-origin-when-cross-origin" env=ADAK_DARKHAST_MELK
  Header always set X-Frame-Options "SAMEORIGIN" env=ADAK_DARKHAST_MELK
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" env=ADAK_DARKHAST_MELK
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://amlakadak.ir; font-src 'self' https://fonts.gstatic.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://api.telegram.org; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests" env=ADAK_DARKHAST_MELK
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=ADAK_DARKHAST_MELK
  SetEnvIf Request_URI "^/sabt-file/" ADAK_SABT_FILE=1
  Header always set X-Content-Type-Options "nosniff" env=ADAK_SABT_FILE
  Header always set Referrer-Policy "strict-origin-when-cross-origin" env=ADAK_SABT_FILE
  Header always set X-Frame-Options "SAMEORIGIN" env=ADAK_SABT_FILE
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" env=ADAK_SABT_FILE
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://amlakadak.ir; font-src 'self' https://fonts.gstatic.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://api.telegram.org; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests" env=ADAK_SABT_FILE
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=ADAK_SABT_FILE
  SetEnvIf Request_URI "^/assets/" ADAK_ASSETS=1
  Header always set Cache-Control "public, max-age=31536000, immutable" env=ADAK_ASSETS
  SetEnvIf Request_URI "^/admin/" ADAK_ADMIN=1
  Header always set X-Robots-Tag "noindex, nofollow" env=ADAK_ADMIN
  Header always set Cache-Control "no-store" env=ADAK_ADMIN
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # always HTTPS (matches the upgrade-insecure-requests policy above)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteRule ^files/?$ /darkhast-melk/ [R=301,L]
  RewriteRule ^p/adk-02(?:\.html|/)?$ /tour/ [R=301,L]
  RewriteRule ^(?:p/|property/|property\.html$|tour/adk-06(?:/|$)|qr\.html$|inventory\.html$) - [G,L]
  RewriteRule ^(darkhast-melk|sabt-file)/form\.html$ /$1/ [R=301,L]
  # admin API - PHP stands in for the Netlify Function
  # some hosts drop the Authorization header before PHP sees it
  RewriteRule ^api/admin/ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteCond %{REQUEST_URI} !^/api/admin/index\.php$
  RewriteRule ^api/admin/.*$ /api/admin/index.php [L,QSA]

</IfModule>

<FilesMatch "^(\.env|\.git.*|.*\.py|.*\.mjs|.*\.sql|.*\.md|.*\.toml|_headers|_redirects)$">
  Require all denied
</FilesMatch>
