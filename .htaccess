# generated by scripts/build_seo.py - do not edit by hand
# Apache / LiteSpeed equivalent of _headers + _redirects + netlify.toml

DirectoryIndex index.html
Options -Indexes -MultiViews
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# let the admin API receive the Authorization header on FastCGI hosts
<IfModule mod_cgi.c>
  CGIPassAuth On
</IfModule>
<IfModule mod_proxy_fcgi.c>
  CGIPassAuth On
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType text/javascript .js .mjs
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  SetEnvIf Request_URI "^/assets/" ADAK_ASSETS=1
  Header always set Cache-Control "public, max-age=31536000, immutable" env=ADAK_ASSETS
  SetEnvIf Request_URI "^/admin/" ADAK_ADMIN=1
  Header always set X-Robots-Tag "noindex, nofollow" env=ADAK_ADMIN
  Header always set Cache-Control "no-store" env=ADAK_ADMIN
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # always HTTPS (matches the upgrade-insecure-requests policy above)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # legacy listing URLs (from netlify.toml)
  RewriteRule ^property/019/?$ /p/adk-019 [R=301,L]
  RewriteRule ^property/boustan-19/?$ /p/adk-019 [R=301,L]

  # admin API - PHP stands in for the Netlify Function
  # some hosts drop the Authorization header before PHP sees it
  RewriteRule ^api/admin/ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteCond %{REQUEST_URI} !^/api/admin/index\.php$
  RewriteRule ^api/admin/.*$ /api/admin/index.php [L,QSA]

  # one rule per published listing (clean URL, with or without trailing slash)
  RewriteRule ^p/adk-019/?$ /property.html [L]
  RewriteRule ^p/adk-03/?$ /p/adk-03.html [L]
  RewriteRule ^p/adk-02/?$ /p/adk-02.html [L]
  RewriteRule ^p/baghestan-93m/?$ /p/baghestan-93m.html [L]
  RewriteRule ^p/adk-05/?$ /p/adk-05.html [L]
  RewriteRule ^p/adk-06/?$ /p/adk-06.html [L]

  # anything else under /p/ that is not a real file is a genuine 404
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^p/ - [R=404,L]
</IfModule>

<FilesMatch "^(\.env|\.git.*|.*\.py|.*\.mjs|.*\.sql|.*\.md|.*\.toml|_headers|_redirects)$">
  Require all denied
</FilesMatch>
